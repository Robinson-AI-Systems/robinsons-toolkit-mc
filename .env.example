# ══════════════════════════════════════════════════════════════════════════════
#  Robinson's Toolkit MCP v2.0 — Environment Configuration
#
#  Copy this file to .env and fill in the keys for the services you use.
#  Any blank key means that namespace won't appear in the toolkit.
#  
#  STRUCTURE:
#  1. Core workspace config (required)
#  2. Business & Admin Infrastructure (your org management + deployments)
#  3. Business-Level LLMs & Search (general AI for business operations)
#  4. Stripe Payments (business transaction layer)
#  5. Project-Specific Services (pick & choose per project)
#  6. Google Workspace (flexible: business or project)
#  7. Local & Always-On Services (no API key needed)
#
#  local, compound, ollama, and playwright are always available — no keys required.
# ══════════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════════
#  1. CORE WORKSPACE CONFIGURATION (always needed)
# ═══════════════════════════════════════════════════════════════════════════════

# The root directory Claude is allowed to read/write files in
WORKSPACE_ROOT=


# ═══════════════════════════════════════════════════════════════════════════════
#  2. BUSINESS & ADMIN INFRASTRUCTURE
#     Your org's dev ops, deployments, issue tracking, communication.
# ═══════════════════════════════════════════════════════════════════════════════

# ── GITHUB (Code Management) ───────────────────────────────────────────────────
# https://github.com/settings/tokens → Personal access token (classic)
# Scopes: repo, workflow, read:org, admin:repo_hook
GITHUB_TOKEN=

# ── VERCEL (Deployment & Hosting) ──────────────────────────────────────────────
# https://vercel.com/account/tokens
VERCEL_TOKEN=
# Optional: default team ID for team operations (if you're part of a Vercel team)
VERCEL_TEAM_ID=

# ── FLY.IO (Deployment & Hosting) ──────────────────────────────────────────────
# Run: fly tokens create deploy -x 999999h
FLY_API_TOKEN=

# ── CLOUDFLARE (CDN, DNS, Security) ────────────────────────────────────────────
# https://dash.cloudflare.com/profile/api-tokens → Create Token
# Your account ID is in the right sidebar of any zone dashboard
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── LINEAR (Issue Tracking & Planning) ─────────────────────────────────────────
# https://linear.app → Settings → API → Personal API keys
LINEAR_API_KEY=

# ── SLACK (Team Communication) ─────────────────────────────────────────────────
# https://api.slack.com/apps → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=
# Optional: default channel for quick sends
SLACK_DEFAULT_CHANNEL=


# ═══════════════════════════════════════════════════════════════════════════════
#  3. DATABASES & BACKEND SERVICES (Admin Infrastructure)
#     Managed database services and persistent stores.
# ═══════════════════════════════════════════════════════════════════════════════

# ── NEON (PostgreSQL Hosting) ──────────────────────────────────────────────────
# https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=

# ── POSTGRES (Direct DB Connection) ────────────────────────────────────────────
# Direct connection string for any Postgres instance (separate from Neon).
# Use this if you have: self-hosted Postgres, Docker containers, AWS RDS, DigitalOcean,
# or any other Postgres provider. Format: postgresql://user:password@host:port/database
# Leave blank if you're only using Neon or another hosted service above.
POSTGRES_CONNECTION_STRING=


# ═══════════════════════════════════════════════════════════════════════════════
#  4. AUTHENTICATION & MONITORING (Admin Tools)
#     User management and production observability.
# ═══════════════════════════════════════════════════════════════════════════════

# ── CLERK (Authentication & User Management) ───────────────────────────────────
# https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=

# ── SENTRY (Error Tracking & Monitoring) ───────────────────────────────────────
# https://sentry.io/settings/account/api/auth-tokens
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=# Optional: default project slug for issue tracking (can also be passed per-tool)
SENTRY_PROJECT_SLUG=

# ═══════════════════════════════════════════════════════════════════════════════
#  5. BUSINESS-LEVEL AI SERVICES
#     General-purpose LLMs and search for business operations & research.
# ═══════════════════════════════════════════════════════════════════════════════

# ── OPENAI (GPT Models) ────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: separate key for admin operations (file uploads, model management)
OPENAI_ADMIN_KEY=

# ── ANTHROPIC (Claude Models) ──────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional: separate key for admin operations (file uploads, model management)
ANTHROPIC_ADMIN_KEY=

# ── GEMINI (Google Generative AI) ──────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
# Enables all gemini_* tools: text, structured JSON, code execution, grounded
# search, multimodal (image/audio/video/PDF), Imagen image generation, TTS,
# embeddings, context caching, batch processing, deep research operations.
GEMINI_API_KEY=

# ── WEB SEARCH (Research & Information Gathering) ──────────────────────────────
# Either/or: Brave Search OR Tavily (or both)
# Brave Search: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=
# Tavily: https://app.tavily.com
TAVILY_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
#  6. STRIPE PAYMENTS (Business Transactions)
#     Payment processing and revenue operations.
# ═══════════════════════════════════════════════════════════════════════════════

# ── STRIPE ─────────────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
#  7. PROJECT-SPECIFIC SERVICES
#     Pick & choose based on your project's needs. Mix & match by project.
# ═══════════════════════════════════════════════════════════════════════════════

# ── TWILIO (SMS/Voice Communication) ───────────────────────────────────────────
# https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: default phone number for SMS/voice operations (E.164 format: +1234567890)
TWILIO_PHONE_NUMBER=
# Optional: default Verify service SID for 2FA/OTP operations
TWILIO_VERIFY_SERVICE_SID=

# ── RESEND (Email Delivery) ────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=

# ── MAPBOX (Maps, Geocoding, Routes) ───────────────────────────────────────────
# https://account.mapbox.com/access-tokens
MAPBOX_ACCESS_TOKEN=
# Required for dataset/tileset/style operations:
MAPBOX_USERNAME=

# ── CONTEXT7 (Knowledge Context & Docs) ────────────────────────────────────────
# https://context7.com/dashboard
CONTEXT7_API_KEY=

# ── SUPABASE (Project Database + Realtime) ─────────────────────────────────────
# https://app.supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── UPSTASH (Redis Cache, Vector Store, Kafka) ────────────────────────────────
# https://console.upstash.com
# Redis REST API:
UPConsole API authentication (optional, for advanced console operations):
UPSTASH_API_KEY=
UPSTASH_EMAIL=
# STASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vector Store (if using):
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# Kafka (if using):
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_TOKEN=

# ── QDRANT (Vector Database) ───────────────────────────────────────────────────
# Local: http://localhost:6333
# Cloud: https://your-cluster.qdrant.io
QDRANT_URL=
# Only needed if your Qdrant instance requires auth:
QDRANT_API_KEY=

# ── N8N (Workflow Automation) ──────────────────────────────────────────────────
# Self-hosted or cloud instance
N8N_BASE_URL=
N8── GOOGLE WORKSPACE (Business or Project — Your Choice)
#     Gmail, Drive, Docs, Sheets, Slides, Calendar, Forms, Contacts.
#     Use either personal OAuth or service account depending on your setup.
# ═══════════════════════════════════════════════════════════════════════════════

# Option A: Personal OAuth token (for personal Google accounts)
GOOGLE_ACCESS_TOKEN=
# Option B: Service account key file path (for workspace/server use)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
# Optional: subject email for service account delegation (for G Suite)
GOOGLE_SERVICE_ACCOUNT_SUBJECTn (for personal Google accounts)
GOOGLE_ACCESS_TOKEN=
# Option B: Service account key file path (for workspace/server use)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=


# ═══════════════════════════════════════════════════════════════════════════════
#  9. LOCAL & ALWAYS-ON SERVICES (No API key needed)
#     These are always available. No configuration required.
# ═══════════════════════════════════════════════════════════════════════════════

# ── OLLAMA (Local LLM Running on Your Machine) ─────────────────────────────────
# WSL2 users: use http://172.19.16.1:11434 to access Windows host from Linux
# Linux users: typically http://localhost:11434
# Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://172.19.16.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=300000

#     Optional: restrict write operations to specific paths (comma-separated)
ALLOWED_WRITE_PATHS=
# ── LOCAL (File System & Workspace Tools)
#     Always on — read/write files, search, task automation. No key needed.

# ── COMPOUND (Multi-Tool Orchestration & Rollback)
#     Always on — chains multiple tools, records operations, supports rollback.
#     See: compound_rollback_transaction

# ── PLAYWRIGHT (Browser Automation & Scraping)
#     Always on — headless browser control, screenshot, DOM interaction.
