# ================================================================
# Robinson's Toolkit MCP - Environment Variables
# Copy this file to .env and fill in your credentials.
# Leave any blank — those tools simply won't appear. Nothing breaks.
# ================================================================

# ── CORE ──────────────────────────────────────────────────────────
# Optional master API key if you expose this as a REST API too
TOOLKIT_API_KEY=

# ── GITHUB ────────────────────────────────────────────────────────
# Create at: github.com/settings/tokens
# Needs: repo, workflow, read:org, gist, admin:repo_hook
GITHUB_TOKEN=

# ── VERCEL ────────────────────────────────────────────────────────
# Create at: vercel.com/account/tokens
VERCEL_TOKEN=

# ── NEON (PostgreSQL) ──────────────────────────────────────────────
# Create at: console.neon.tech/app/settings/api-keys
NEON_API_KEY=

# ── UPSTASH (Redis) ────────────────────────────────────────────────
# Found at: console.upstash.com → your database → Details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# For database management tools (not just data tools):
UPSTASH_API_KEY=
UPSTASH_EMAIL=

# ── FLY.IO ────────────────────────────────────────────────────────
# Create at: fly.io/user/personal_access_tokens
FLY_API_TOKEN=

# ── STRIPE ────────────────────────────────────────────────────────
# Found at: dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# For Stripe Connect (multi-tenant billing for YardSync/Cortiware):
STRIPE_WEBHOOK_SECRET=

# ── RESEND (Email) ────────────────────────────────────────────────
# Create at: resend.com/api-keys
RESEND_API_KEY=

# ── TWILIO (SMS/Voice) ────────────────────────────────────────────
# Found at: console.twilio.com/us1/account/keys-credentials/api-key-list
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── CLOUDFLARE ────────────────────────────────────────────────────
# Create at: dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── OPENAI ────────────────────────────────────────────────────────
# Create at: platform.openai.com/api-keys
OPENAI_API_KEY=

# ── ANTHROPIC ─────────────────────────────────────────────────────
# Create at: console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# ── SUPABASE ──────────────────────────────────────────────────────
# Found at: supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── MAPBOX ────────────────────────────────────────────────────────
# Create at: account.mapbox.com/access-tokens
# Used for YardSync route optimization and geocoding
MAPBOX_ACCESS_TOKEN=

# ── CLERK (Auth) ──────────────────────────────────────────────────
# Found at: dashboard.clerk.com → your app → API Keys
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ── SENTRY (Error Monitoring) ─────────────────────────────────────
# Found at: sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

# ── WEB SEARCH ────────────────────────────────────────────────────
# Brave: api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=
# Tavily: app.tavily.com/home
TAVILY_API_KEY=

# ── GOOGLE WORKSPACE ──────────────────────────────────────────────
# Option A: OAuth Access Token (paste a fresh token here)
GOOGLE_ACCESS_TOKEN=
# Option B: Service Account JSON file path
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# ── QDRANT (Vector Database) ──────────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=

# ── N8N (Workflow Automation) ─────────────────────────────────────
N8N_BASE_URL=
N8N_API_KEY=

# ── POSTGRES (Direct connection - any database) ───────────────────
# Connection string format: postgresql://user:password@host:5432/dbname
POSTGRES_CONNECTION_STRING=

# ── LOCAL MACHINE ─────────────────────────────────────────────────
# Where your projects live (for relative path operations)
# Example: C:\Users\chris\Git Local
WORKSPACE_ROOT=
# Safety: comma-separated paths the agent is ALLOWED to write to
# Leave blank to allow anywhere under WORKSPACE_ROOT
ALLOWED_WRITE_PATHS=
